DATABASE_URL=postgresql://postgres:password@localhost:5432/credits_db
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=admin@example.com

# ---------- Customization ----------
# Schedule shape — application-layer only; widening these for real also
# requires a database migration to match the CHECK constraints. See
# app/config.py and database/README.md before changing these in production.
PERIODS_PER_DAY=5
DAY_ORDER_MAX=6

# Branding
APP_NAME=FAFLOW
PRIMARY_COLOR=#4f46e5

# Deployment
FRONTEND_ORIGIN=["http://localhost:5173"]
MAX_SECONDARY_ADMINS=3

# Backup & Restore
# Directory where backup files are stored (relative to backend root, or absolute path).
BACKUP_STORAGE_PATH=./backups
# Soft limit on how many user-created backups to retain (not auto-enforced by default).
BACKUP_RETENTION_COUNT=50
# Maximum allowed backup file size in megabytes.
BACKUP_MAX_SIZE_MB=500

# ---------- Object Storage & Announcements ----------
# Storage backend: "local" (default filesystem) or "s3" (AWS S3 / MinIO / Cloudflare R2)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage/announcements
# S3 / MinIO settings (required if STORAGE_BACKEND=s3)
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_SIGNED_URL_EXPIRE_SECONDS=900
ANNOUNCEMENT_MAX_ATTACHMENT_SIZE_MB=25
ANNOUNCEMENT_MAX_ATTACHMENTS_PER_POST=5
